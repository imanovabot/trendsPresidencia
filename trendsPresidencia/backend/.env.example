# Google Trends (pytrends no necesita API key)
PYTRENDS_LANGUAGE=es-CO
PYTRENDS_REGION=CO

# YouTube Data API v3
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# HuggingFace Sentiment
HUGGINGFACE_API_KEY=tu_hf_api_key_aqui  # Opcional, modelo público por defecto

# RSS/News
NEWS_UPDATE_INTERVAL_MINUTES=30

# Cache
CACHE_TTL_SECONDS=21600  # 6 horas

# API
API_V1_STR=/api/v1
PROJECT_NAME=trendsPresidencia API
