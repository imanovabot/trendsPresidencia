# ============================================
# API Keys para redes sociales
# ============================================

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok API (Apify, RapidAPI, o similar)
TIKTOK_API_KEY=your_tiktok_api_key_here

# X/Twitter API v2 Bearer Token
X_BEARER_TOKEN=your_x_bearer_token_here

# Instagram Graph API (Access Token)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# HuggingFace (para análisis de sentimiento)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================
# Configuración de pytrends
# ============================================
PYTRENDS_LANGUAGE=es-CO
PYTRENDS_REGION=CO

# ============================================
# Configuración de News
# ============================================
NEWS_UPDATE_INTERVAL_MINUTES=30

# ============================================
# Cache
# ============================================
CACHE_TTL_SECONDS=21600

# ============================================
# API
# ============================================
API_V1_STR=/api/v1
PROJECT_NAME=trendsPresidencia API
